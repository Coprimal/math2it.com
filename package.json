{
  "name": "math2it-nextjs",
  "description": "A Next.js version of Math2IT",
  "version": "0.0.1",
  "author": "Math2IT Team",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next lint && next build",
    "start": "next start",
    "lint": "next lint",
    "check": "yarn run prettier && yarn run build",
    "prettier": "prettier --write \"**/*.{tsx,ts,css,scss}\"",
    "clean": "rimraf .next && rimraf .vercel && rimraf .netlify",
    "clean-build": "yarn run clean && yarn run build",
    "reinstall": "yarn run clean && rimraf node_modules && rm yarn.lock && yarn install",
    "ud-fontello": "rimraf .fontello-session && fontello-cli --config src/fontello/config.json --css src/fontello/css --font src/fontello/font install",
    "ud-header-all": "tsx -r dotenv/config ./scripts/ud_images.ts dotenv_config_path=.env.local --a headerAll --dbid 7c2e54318e52416ca5769831454bf08d",
    "ud-header-all-test": "tsx -r dotenv/config ./scripts/ud_images.ts dotenv_config_path=.env.local --a headerAll --dbid fb11f7382dc14f6787674b775cda81c9",
    "ud-header": "npx tsx -r dotenv/config ./scripts/ud_images.ts dotenv_config_path=.env.local --a headerPost --pid",
    "ud-images": "npx tsx -r dotenv/config ./scripts/ud_images.ts dotenv_config_path=.env.local --a imagesInPost --pid"
  },
  "dependencies": {
    "@headlessui/react": "^1.7.15",
    "@matejmazur/react-katex": "^3.1.3",
    "@notionhq/client": "^2.2.5",
    "@plaiceholder/next": "^3.0.0",
    "@tippyjs/react": "^4.2.6",
    "@types/node": "20.2.5",
    "@types/react": "18.2.9",
    "@types/react-dom": "18.2.4",
    "autoprefixer": "10.4.14",
    "classnames": "^2.3.2",
    "eslint": "8.42.0",
    "eslint-config-next": "13.4.4",
    "got": "^12.6.0",
    "html-react-parser": "^4.0.0",
    "katex": "^0.16.7",
    "lodash": "^4.17.21",
    "mermaid": "^10.2.3",
    "moment": "^2.29.4",
    "next": "13.4.4",
    "node-fetch": "^3.3.1",
    "plaiceholder": "^3.0.0",
    "prismjs": "^1.29.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-icons": "^4.9.0",
    "react-syntax-highlighter": "^15.5.0",
    "react-youtube": "^10.1.0",
    "sharp": "^0.32.1",
    "swr": "^2.1.5",
    "typescript": "5.1.3"
  },
  "devDependencies": {
    "@babel/core": "^7.0.0-0",
    "@babel/plugin-syntax-flow": "^7.14.5",
    "@babel/plugin-transform-react-jsx": "^7.14.9",
    "@tailwindcss/typography": "^0.5.9",
    "@trivago/prettier-plugin-sort-imports": "^4.1.1",
    "@types/lodash": "^4.14.195",
    "@types/prismjs": "^1.26.0",
    "@types/react-syntax-highlighter": "^15.5.7",
    "@types/yargs": "^17.0.24",
    "@typescript-eslint/eslint-plugin": "^5.59.11",
    "@typescript-eslint/parser": "^5.59.11",
    "chalk": "^5.2.0",
    "dotenv": "^16.1.4",
    "eslint-config-prettier": "^8.8.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-tailwindcss": "^3.12.1",
    "postcss": "8.4.24",
    "prettier": "^2.8.8",
    "prettier-plugin-tailwindcss": "^0.3.0",
    "rimraf": "^5.0.1",
    "sass": "^1.63.3",
    "tailwindcss": "3.3.2",
    "yargs": "^17.7.2"
  }
}
